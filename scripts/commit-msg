#!/usr/bin/env sh

commit_msg_file="$1"
first_line=$(head -n 1 "$commit_msg_file")

pattern='^(Feature|Fix|Refactor|Style|Docs|Chore): .+'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "❌ Invalid commit message format."
  echo ""
  echo "  Expected: Type: 변경 요약"
  echo "  Types:    Feature | Fix | Refactor | Style | Docs | Chore"
  echo ""
  echo "  Example:  Feature: 로그인 화면 추가"
  echo "  Got:      $first_line"
  exit 1
fi
